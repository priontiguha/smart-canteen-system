@model List<canteen_management.Models.Order>
@{
    ViewData["Title"] = "My Orders";
}

<div class="dashboard-page">
    <div class="dashboard-header">
        <div>
            <p class="text-muted mb-1">Customer</p>
            <h1>My Orders</h1>
        </div>
    </div>

    <div class="dashboard-section">
        @if (Model == null || Model.Count == 0)
        {
            <div class="text-center py-5 text-muted">
                <h5>No orders yet.</h5>
                <p class="mb-0">Your recent food orders will appear here.</p>
            </div>
        }
        else
        {
            @foreach (var order in Model)
            {
                <div class="border rounded p-3 mb-3 shadow-sm">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <h5 class="mb-1">Order #@order.Id.ToString().Substring(0, 8)</h5>
                            <small class="text-muted">@order.CreatedAt.ToLocalTime().ToString("ddd, MMM d, yyyy")</small>
                        </div>
                        <span class="badge @(order.Status == canteen_management.Models.OrderStatus.Delivered ? "bg-success" : order.Status == canteen_management.Models.OrderStatus.ReadyForPickup ? "bg-warning text-dark" : order.Status == canteen_management.Models.OrderStatus.Preparing ? "bg-info text-dark" : "bg-primary")">@order.Status</span>
                    </div>

                    <ul class="list-group list-group-flush mb-3">
                        @foreach (var item in order.Items)
                        {
                            <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                                <span>@item.MenuItem.Name x @item.Quantity</span>
                                <strong>$@item.TotalPrice</strong>
                            </li>
                        }
                    </ul>

                    <div class="d-flex justify-content-between align-items-center border-top pt-3">
                        <strong>Total</strong>
                        <strong>$@order.TotalAmount</strong>
                    </div>

                    @if (order.Status == canteen_management.Models.OrderStatus.ReadyForPickup)
                    {
                        <form asp-action="MarkDelivered" method="post" class="mt-3">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@order.Id" />
                            <button type="submit" class="btn btn-success w-100">Mark as Delivered</button>
                        </form>
                    }
                </div>
            }
        }
    </div>
</div>
