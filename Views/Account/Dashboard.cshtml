@model dynamic
@{
    ViewData["Title"] = "Dashboard";
    var isAdmin = User.IsInRole("Admin");
}

<div class="dashboard-page">
    <div class="dashboard-header">
        <div>
            <p class="text-muted mb-1">Smart Canteen</p>
            <h1>Welcome, @User.Identity?.Name! 👋</h1>
        </div>
        <span class="badge text-bg-light border">@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</span>
    </div>

    @if (TempData["AdminSuccessMessage"] != null)
    {
        <div class="alert alert-success mb-4">@TempData["AdminSuccessMessage"]</div>
    }

    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="dashboard-card">
                <div class="card-icon">📦</div>
                <h4>Menu Items</h4>
                <p>24 Active</p>
                <button class="btn btn-primary btn-sm">Open</button>
            </div>
        </div>
        <div class="col-md-3">
            <div class="dashboard-card">
                <div class="card-icon">🛒</div>
                <h4>Orders</h4>
                <p>18 Today</p>
                <button class="btn btn-primary btn-sm">View</button>
            </div>
        </div>
        <div class="col-md-3">
            <div class="dashboard-card">
                <div class="card-icon">💰</div>
                <h4>Revenue</h4>
                <p>$1,250</p>
                <button class="btn btn-primary btn-sm">Report</button>
            </div>
        </div>
        <div class="col-md-3">
            <div class="dashboard-card">
                <div class="card-icon">⚠️</div>
                <h4>Low Stock</h4>
                <p>5 Items</p>
                <button class="btn btn-primary btn-sm">Review</button>
            </div>
        </div>
    </div>

    @if (isAdmin)
    {
        <div class="dashboard-section mb-4">
            <div class="section-heading">
                <div>
                    <h3>Create User</h3>
                    <p class="text-muted mb-0">Add student, faculty, or kitchen staff accounts.</p>
                </div>
            </div>

            <form asp-action="CreateUser" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label" for="FullName">Full Name</label>
                        <input class="form-control" id="FullName" name="FullName" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="Email">Email</label>
                        <input class="form-control" id="Email" name="Email" type="email" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="Role">Role</label>
                        <select class="form-select" id="Role" name="Role" required>
                            <option value="Student">Student</option>
                            <option value="Faculty">Faculty</option>
                            <option value="KitchenStaff">Kitchen Staff</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="Password">Password</label>
                        <input class="form-control" id="Password" name="Password" type="password" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="ConfirmPassword">Confirm Password</label>
                        <input class="form-control" id="ConfirmPassword" name="ConfirmPassword" type="password" required />
                    </div>
                </div>

                <div class="mt-3">
                    <button type="submit" class="btn btn-success">Create User</button>
                </div>
            </form>
        </div>
    }

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="dashboard-section h-100">
                <div class="section-heading">
                    <div>
                        <h3>Recent Orders</h3>
                        <p class="text-muted mb-0">Latest customer activity</p>
                    </div>
                    <span class="badge bg-primary">Live</span>
                </div>

                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th>Order</th>
                                <th>Customer</th>
                                <th>Time</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>#1024</td>
                                <td>John Doe</td>
                                <td>12:30 PM</td>
                                <td><span class="badge bg-warning text-dark">Pending</span></td>
                            </tr>
                            <tr>
                                <td>#1025</td>
                                <td>Alice Smith</td>
                                <td>12:45 PM</td>
                                <td><span class="badge bg-info text-dark">Preparing</span></td>
                            </tr>
                            <tr>
                                <td>#1026</td>
                                <td>Mark Lee</td>
                                <td>1:00 PM</td>
                                <td><span class="badge bg-success">Ready</span></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="dashboard-section h-100">
                <h3>Account</h3>

                <div class="profile-info">
                    <div class="profile-avatar">@User.Identity?.Name?.Substring(0, 1).ToUpper()</div>
                    <div>
                        <h5 class="mb-1">@User.Identity?.Name</h5>
                        <p class="text-muted mb-0">@User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value</p>
                    </div>
                </div>

                <div class="account-row">
                    <span>Role</span>
                    <span>@(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Student")</span>
                </div>
                <div class="account-row">
                    <span>Status</span>
                    <span class="badge bg-success">Active</span>
                </div>
            </div>
        </div>
    </div>
</div>

