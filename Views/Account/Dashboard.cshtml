@model dynamic
@{
    ViewData["Title"] = "Dashboard";
    var isAdmin = User.IsInRole("Admin");
}

<div class="container-fluid dashboard-page py-4">

    <!-- Welcome Header -->
    <div class="dashboard-header mb-4">
        <div>
            <p class="text-muted mb-1">Smart Canteen</p>
            <h1 class="fw-bold mb-1">
                Welcome, @User.Identity?.Name! 👋
            </h1>
            <p class="text-muted mb-0">
                What would you like to have today?
            </p>
        </div>

        <a asp-action="Logout"
           asp-controller="Account"
           class="btn btn-outline-danger">
            Logout
        </a>
    </div>

    @if (TempData["AdminSuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["AdminSuccessMessage"]</div>
    }

    <!-- Quick Action Cards -->
    <div class="row g-4 mb-4">

        @if (isAdmin)
        {
            <div class="col-md-4">
                <div class="dashboard-card h-100 border-primary">
                    <div class="card-icon">⚙️</div>
                    <h4>Admin Panel</h4>
                    <p class="text-muted">
                        Manage menu items, users, and canteen settings.
                    </p>
                    <button class="btn btn-primary" type="button">Open Admin Tools</button>
                </div>
            </div>
        }

        <div class="col-md-4">
            <div class="dashboard-card h-100">
                <div class="card-icon">🍔</div>
                <h4>Browse Menu</h4>
                <p class="text-muted">
                    Explore today's available food items.
                </p>
                <button class="btn btn-primary" disabled>
                    Coming Soon
                </button>
            </div>
        </div>

        <div class="col-md-4">
            <div class="dashboard-card h-100">
                <div class="card-icon">🛒</div>
                <h4>My Orders</h4>
                <p class="text-muted">
                    Check your recent and previous orders.
                </p>
                <button class="btn btn-primary">
                    View Orders
                </button>
            </div>
        </div>

        <div class="col-md-4">
            <div class="dashboard-card h-100">
                <div class="card-icon">👤</div>
                <h4>My Profile</h4>
                <p class="text-muted">
                    View and manage your account information.
                </p>
                <button class="btn btn-primary">
                    View Profile
                </button>
            </div>
        </div>

    </div>

    @if (isAdmin)
    {
        <div class="dashboard-section mb-4">
            <h3>Create User</h3>
            <form asp-action="CreateUser" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label" for="FullName">Full Name</label>
                        <input class="form-control" id="FullName" name="FullName" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="Email">Email</label>
                        <input class="form-control" id="Email" name="Email" type="email" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="Role">Role</label>
                        <select class="form-select" id="Role" name="Role" required>
                            <option value="Student">Student</option>
                            <option value="Faculty">Faculty</option>
                            <option value="KitchenStaff">Kitchen Staff</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="Password">Password</label>
                        <input class="form-control" id="Password" name="Password" type="password" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="ConfirmPassword">Confirm Password</label>
                        <input class="form-control" id="ConfirmPassword" name="ConfirmPassword" type="password" required />
                    </div>
                </div>

                <div class="mt-3">
                    <button type="submit" class="btn btn-success">Create User</button>
                </div>
            </form>
        </div>
    }

    <!-- Dashboard Content -->
    <div class="row g-4">

        <!-- Today's Special -->
        <div class="col-lg-8">
            <div class="dashboard-section h-100">
                <div class="section-heading">
                    <div>
                        <h3>Today's Special</h3>
                        <p class="text-muted mb-0">
                            Popular choices from our canteen
                        </p>
                    </div>
                    <span class="badge bg-primary">Popular</span>
                </div>

                <div class="food-placeholder">
                    <div class="food-icon">🍽️</div>
                    <h4>Delicious meals are waiting for you!</h4>
                    <p class="text-muted">
                        Browse the menu and choose your favourite food.
                    </p>
                    <button class="btn btn-primary">
                        Explore Menu
                    </button>
                </div>
            </div>
        </div>

        <!-- Account Information -->
        <div class="col-lg-4">
            <div class="dashboard-section h-100">
                <h3>Account Information</h3>

                <div class="profile-info">
                    <div class="profile-avatar">
                        @(User.Identity?.Name?.Substring(0, 1).ToUpper())
                    </div>

                    <div>
                        <h5 class="mb-1">@User.Identity?.Name</h5>
                        <p class="text-muted mb-0">
                            @User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value
                        </p>
                    </div>
                </div>

                <hr />

                <div class="account-row">
                    <span>Account Status</span>
                    <span class="badge bg-success">Active</span>
                </div>

                <div class="account-row">
                    <span>Role</span>
                    <span>@(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Student")</span>
                </div>
            </div>
        </div>

    </div>

</div>
