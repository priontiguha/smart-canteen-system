@model dynamic
@{
    ViewData["Title"] = "Dashboard";
    var isAdmin = User.IsInRole("Admin");
    var isStudent = User.IsInRole("Student");
    var menuCount = (int)(ViewBag.MenuCount ?? 0);
    var orderCount = (int)(ViewBag.OrderCount ?? 0);
    var revenue = (decimal)(ViewBag.Revenue ?? 0m);
    var lowStockCount = (int)(ViewBag.LowStockCount ?? 0);
    var recentOrders = ViewBag.RecentOrders as IEnumerable<canteen_management.Models.Order> ?? new List<canteen_management.Models.Order>();
    var recentOrdersTitle = isAdmin ? "Recent Orders" : "My Recent Orders";
    var recentOrdersSubtitle = isAdmin ? "Latest customer activity" : "Your recent food orders";
}

<div class="dashboard-page">
    <div class="dashboard-header">
        <div>
            <p class="text-muted mb-1">Smart Canteen</p>
            <h1>Welcome, @User.Identity?.Name! 👋</h1>
        </div>
        <span class="badge text-bg-light border">@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</span>
    </div>

    @if (TempData["AdminSuccessMessage"] != null)
    {
        <div class="alert alert-success mb-4">@TempData["AdminSuccessMessage"]</div>
    }

    @if (isAdmin)
    {
        <div class="row g-4 mb-4">
            <div class="col-md-3">
                <div class="dashboard-card">
                    <div class="card-icon">📦</div>
                    <h4>Menu Items</h4>
                    <p>@menuCount Total</p>
                    <a asp-controller="Menu" asp-action="Index" class="btn btn-primary btn-sm">Open</a>
                </div>
            </div>
            <div class="col-md-3">
                <div class="dashboard-card">
                    <div class="card-icon">🛒</div>
                    <h4>Orders</h4>
                    <p>@orderCount Total</p>
                    <a asp-controller="Order" asp-action="KitchenQueue" class="btn btn-primary btn-sm">View</a>
                </div>
            </div>
            <div class="col-md-3">
                <div class="dashboard-card">
                    <div class="card-icon">💰</div>
                    <h4>Revenue</h4>
                    <p>$@revenue.ToString("0.00")</p>
                    <a asp-controller="Wallet" asp-action="Index" class="btn btn-primary btn-sm">Report</a>
                </div>
            </div>
            <div class="col-md-3">
                <div class="dashboard-card">
                    <div class="card-icon">⚠️</div>
                    <h4>Low Stock</h4>
                    <p>@lowStockCount Items</p>
                    <a asp-controller="Menu" asp-action="Index" class="btn btn-primary btn-sm">Review</a>
                </div>
            </div>
        </div>
    }

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="dashboard-section h-100">
                <div class="section-heading">
                    <div>
                        <h3>@recentOrdersTitle</h3>
                        <p class="text-muted mb-0">@recentOrdersSubtitle</p>
                    </div>
                    <span class="badge bg-primary">Live</span>
                </div>

                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th>Order</th>
                                <th>Customer</th>
                                <th>Time</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (recentOrders.Any())
                            {
                                @foreach (var order in recentOrders)
                                {
                                    <tr>
                                        <td>#@order.Id.ToString().Substring(0, 8)</td>
                                        <td>@(order.User?.FullName ?? "Unknown")</td>
                                        <td>@order.CreatedAt.ToLocalTime().ToString("g")</td>
                                        <td><span class="badge @(order.Status == canteen_management.Models.OrderStatus.Delivered ? "bg-success" : order.Status == canteen_management.Models.OrderStatus.ReadyForPickup ? "bg-warning text-dark" : order.Status == canteen_management.Models.OrderStatus.Preparing ? "bg-info text-dark" : "bg-primary")">@order.Status</span></td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-3">No orders yet.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="dashboard-section h-100">
                <h3>Account</h3>

                <div class="profile-info">
                    <div class="profile-avatar">@User.Identity?.Name?.Substring(0, 1).ToUpper()</div>
                    <div>
                        <h5 class="mb-1">@User.Identity?.Name</h5>
                        <p class="text-muted mb-0">@User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value</p>
                    </div>
                </div>

                <div class="account-row">
                    <span>Role</span>
                    <span>@(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Student")</span>
                </div>
                <div class="account-row">
                    <span>Status</span>
                    <span class="badge bg-success">Active</span>
                </div>
            </div>
        </div>
    </div>
</div>

