@model List<canteen_management.Models.GroupOrder>

@{
    ViewData["Title"] = "Group Orders";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Group Orders</h2>
        <a class="btn btn-primary" asp-action="Create">New Group Order</a>
    </div>

    @if (Model == null || Model.Count == 0)
    {
        <p class="text-muted">No group orders found.</p>
    }
    else
    {
        <ul class="list-group">
            @foreach (var g in Model)
            {
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <div>
                        <a asp-action="Details" asp-route-id="@g.Id"><strong>@g.Title</strong></a>
                        <div class="small text-muted">Created: @g.CreatedAt.ToLocalTime()</div>
                    </div>
                    <div>
                        @if (g.IsOpen)
                        {
                            <span class="badge bg-success me-2">Open</span>
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@g.Id">Join</a>
                        }
                        else
                        {
                            <span class="badge bg-secondary me-2">Closed</span>
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@g.Id">View</a>
                        }
                    </div>
                </li>
            }
        </ul>
    }
</div>