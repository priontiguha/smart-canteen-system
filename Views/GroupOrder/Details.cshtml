@model canteen_management.Models.GroupOrder

@{
    ViewData["Title"] = "Group Order Details";
    var items = ViewBag.Items as List<canteen_management.Models.GroupOrderItem> ?? new List<canteen_management.Models.GroupOrderItem>();
}

<div class="container mt-4">
    <h2>@Model.Title</h2>
    <p class="text-muted">Created at: @Model.CreatedAt.ToLocalTime()</p>

    <h4>Items</h4>
    @if (items.Count == 0)
    {
        <p class="text-muted">No items yet.</p>
    }
    else
    {
        <ul class="list-group mb-3">
            @foreach (var it in items)
            {
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <div>
                        <strong>@it.MenuItem?.Name</strong>
                        <div class="small text-muted">Added by: @it.AddedByUserId</div>
                    </div>
                    <span>Qty: @it.Quantity</span>
                </li>
            }
        </ul>
    }

    <h5>Add Item</h5>
    <form asp-action="AddItem" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="groupId" value="@Model.Id" />
        <div class="row g-2 align-items-center">
            <div class="col-auto">
                <select name="menuItemId" class="form-select">
                    @foreach (var m in (ViewBag.MenuItems as List<canteen_management.Models.MenuItem> ?? new List<canteen_management.Models.MenuItem>()))
                    {
                        <option value="@m.Id">@m.Name (@m.Price)</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <input type="number" name="quantity" value="1" min="1" class="form-control" style="width:80px" />
            </div>
            <div class="col-auto">
                <button class="btn btn-primary">Add</button>
            </div>
        </div>
    </form>
</div>
