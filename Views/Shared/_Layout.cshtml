<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Smart Canteen</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @if (User?.Identity?.IsAuthenticated == true)
    {
        <div class="app-shell">
            <aside class="sidebar">
                <div class="sidebar-brand">
                    <div class="brand-badge">SC</div>
                    <div>
                        <h6>Smart Canteen</h6>
                    </div>
                </div>

                <nav class="sidebar-nav">
                    <a class="sidebar-link active" asp-controller="Account" asp-action="Dashboard">
                        <span>🏠</span> Dashboard
                    </a>

                    @if (User.IsInRole("Admin"))
                    {
                        <a class="sidebar-link" asp-controller="Menu" asp-action="Index">
                            <span>🍽️</span> Menu
                        </a>
                        <a class="sidebar-link" asp-controller="Order" asp-action="KitchenQueue">
                            <span>🍳</span> Kitchen Queue
                        </a>
                        <a class="sidebar-link" asp-controller="UserManagement" asp-action="Index">
                            <span>👤</span> Users
                        </a>
                    }
                    else
                    {
                        <a class="sidebar-link" asp-controller="Order" asp-action="Menu">
                            <span>🍽️</span> Menu
                        </a>
                        <a class="sidebar-link" asp-controller="Order" asp-action="MyOrders">
                            <span>🛒</span> Orders
                        </a>
                        <a class="sidebar-link" asp-controller="Wallet" asp-action="Index">
                            <span>💳</span> Wallet
                        </a>
                    }
                </nav>

                <form action="@Url.Action("Logout", "Account")" method="post" class="mt-auto">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-logout w-100">Logout</button>
                </form>
            </aside>

            <div class="main-panel">
                <header class="topbar">
                    <div>
                        <p class="topbar-label">Welcome back</p>
                        <h3>@User.Identity?.Name</h3>
                    </div>
                    <div class="topbar-actions">
                        <span class="badge-role">@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</span>
                    </div>
                </header>

                <main role="main" class="page-content">
                    @RenderBody()
                </main>
            </div>
        </div>
    }
    else
    {
        <div class="auth-shell">
            <main role="main" class="w-100">
                @RenderBody()
            </main>
        </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
